scoreboard players set @s sk_help 0
tellraw @s {"text": "SIGNALKEEPERS — FIELD GUIDE", "color": "gold", "italic": false}
tellraw @s {"text": "/trigger sk_start — begin here, or join the active expedition.", "color": "white", "italic": false}
tellraw @s {"text": "Track three relays. Hold your scanner and right-click. Follow its beam and coordinates.", "color": "gray", "italic": false}
tellraw @s {"text": "Relay I: crouch and scan to listen. Relay II: stand and scan to charge quickly.", "color": "gray", "italic": false}
tellraw @s {"text": "Relay III: restore the first two, let interference fall below 30, then crouch-scan.", "color": "gray", "italic": false}
tellraw @s {"text": "Scanning spends battery. Return within 6 blocks of camp to recharge. At 100 interference, echoes appear.", "color": "gray", "italic": false}
tellraw @s {"text": "Canopy Winch: aim at a tree within 24 blocks and right-click to pull toward it. Costs 6 battery; open paths only.", "color": "gray", "italic": false}
tellraw @s {"text": "Restore all three, return to camp, then scan to hear the ending and claim a relic.", "color": "gray", "italic": false}
tellraw @s {"text": "/trigger sk_kit restores a lost scanner. /trigger sk_leave leaves. The expedition leader can /trigger sk_end.", "color": "gray", "italic": false}
tellraw @s {"text": "Use an open outdoor site in a fresh test world. Normal difficulty recommended. One shared expedition per world.", "color": "yellow", "italic": false}
